{
  "name": "framework-mcps",
  "version": "0.1.0",
  "description": "Manifest-driven MCP framework for turning authorized APIs, websites, CLIs, databases, and files into secure, reusable AI tools.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "bin": {
    "fmcp": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:examples": "tsx src/tools/validate-examples.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-framework",
    "ai-agents",
    "connector-framework",
    "api-integration",
    "openapi",
    "browser-automation",
    "playwright",
    "cli",
    "database",
    "json-schema",
    "automation",
    "security"
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.0",
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
